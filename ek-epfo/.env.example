# ==============================================================================
# EK-EPFO CLIENT ENVIRONMENT CONFIGURATION (.env.example)
# ==============================================================================

# Supabase API Credentials (Public Client SDK)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_anon_key

# ==============================================================================
# NOTE ON EMAIL & SMTP CONFIGURATION:
# ==============================================================================
# SMTP credentials (e.g. Brevo / SendGrid / Resend) are NEVER configured in this
# repository or in client-side .env files.
#
# Custom SMTP is configured directly in the Supabase Cloud Dashboard:
# -> Project Settings -> Authentication -> SMTP Settings
#
# See EMAIL_SETUP.md in the project root for complete setup instructions.
# ==============================================================================
