{
  "buildCommand": "cd ek-epfo && npm run build",
  "installCommand": "cd ek-epfo && npm install",
  "outputDirectory": "ek-epfo/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/resend/:path*",
      "destination": "https://api.resend.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
